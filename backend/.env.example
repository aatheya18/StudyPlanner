# Database configuration: defaults to SQLite for immediate local execution, or PostgreSQL
DATABASE_URL=sqlite:///./study_planner.db
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/study_planner

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# API base url
API_BASE_URL=http://localhost:8000

# Machine learning model artifacts directory
MODEL_ARTIFACT_PATH=backend/app/ml/artifacts

# Synthetic demonstration dataset path
DATASET_PATH=data/sample/study_dataset.csv

# Application environment
APPLICATION_ENV=development
